# =============================================================================
# ReadyMarine — environment template
# =============================================================================
# Quick start, from a clean clone:
#
#   cp .env.example .env
#   cp .env.example Backend/.env
#   docker compose up -d --build
#
#   frontend  → http://localhost:3041
#   backend   → http://localhost:4041
#   mongo     → inside the compose network only (see docker-compose.localdev.yml
#               if you need to reach it from the host)
#
# The values below are filled in with working local defaults, so that command
# brings the whole stack up as-is. Everything that is a real credential is left
# blank instead — those features stay switched off until you paste a key in,
# and the app is written to survive that (no email, no WhatsApp, no online
# payment — the rest of the site still works).
#
# Why two copies of the same file:
#   ./.env          is read by docker compose itself, to fill the ${...} holes
#                   in docker-compose.yml.
#   ./Backend/.env  is handed to the backend container as-is (`env_file`), and
#                   is what the Node process actually reads.
# Neither side minds the keys it does not use, so one filled template serves
# both. Note compose refuses to start at all when Backend/.env is missing.
#
# File rules: one KEY=value per line, no quotes, no spaces around the `=`, and
# a comment on its own line. A quote becomes part of the value here rather than
# wrapping it, and so does a trailing `# note` — the value runs to end of line.
#
# Anything marked (optional) already has a sane default inside the code — drop
# the line entirely and the documented default applies.
#
# *** Before putting any of this on a server: regenerate every value marked
# *** CHANGE ME. They are public knowledge, they sit in this file on GitHub.
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Mongo's root user, created the first time the container starts on an empty
# ./docker-data/mongo. Changing them later does NOT update an existing volume —
# you would have to create the user by hand or wipe the directory.
# Compose refuses to start if either one is empty.
MONGO_ROOT_USERNAME=readymarine_admin
# CHANGE ME on any real server.
MONGO_ROOT_PASSWORD=e4c622c0365a84711c5cfda705598d409f4ed2487f85903a

# Full connection string for the backend. Inside docker this is overridden by
# docker-compose.yml (it builds the string from the two values above and points
# at the `mongo` service), so you only need this when you run the backend
# natively on the host — then start mongo with:
#   docker compose -f docker-compose.yml -f docker-compose.localdev.yml up -d mongo
MONGO_URI=mongodb://readymarine_admin:e4c622c0365a84711c5cfda705598d409f4ed2487f85903a@localhost:27018/readymarine?authSource=admin
# (optional) Old alias, still read by a few maintenance scripts as a fallback.
# MONGODB_URI=


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port inside the container. docker-compose.yml pins it to 4000 and publishes
# it on the host as 4041; this line is for running the backend natively.
PORT=4000

# `production` turns on secure cookies — which browsers only accept over HTTPS.
# Keep it `development` locally or you will be logged out on every request.
NODE_ENV=development

# Where the browser reaches the site. Used for CORS, for socket.io's allowed
# origin, and for every link inside an email or a WhatsApp message.
# Local:  http://localhost:3041      Server: https://readymarine.store
FRONTEND_URL=http://localhost:3041

# Where the outside world reaches this API. Used to build absolute URLs for
# uploaded images and for payment/webhook callbacks, so a wrong value here
# shows up as broken product images rather than an error.
# Local:  http://localhost:4041      Server: https://readymarine.store
BACKEND_PUBLIC_URL=http://localhost:4041
# (optional) Older names for the same thing, tried in that order when
# BACKEND_PUBLIC_URL is unset. No need to set them.
# BACKEND_URL=
# API_PUBLIC_URL=


# -----------------------------------------------------------------------------
# Frontend build arguments
# -----------------------------------------------------------------------------
# Next.js bakes NEXT_PUBLIC_* into the JS bundle at BUILD time, not at run time.
# docker-compose.yml passes these as build args, which means changing them needs
# `docker compose up -d --build frontend` — a plain restart keeps the old value.
NEXT_PUBLIC_API_URL=http://localhost:4041/api
NEXT_PUBLIC_SITE_URL=http://localhost:3041


# -----------------------------------------------------------------------------
# Secrets — signing keys and the admin account
# -----------------------------------------------------------------------------
# Three separate JWT signing keys, one per audience, so a stolen customer token
# can never be replayed as a vendor or an admin one. An empty value does not
# disable anything, it crashes the login route — hence the dev defaults.
# Every value in this block is a CHANGE ME. Generate real ones with:
#   openssl rand -hex 32
JWT_SECRET_USER=396ab4f0af87ad8b18a9c9d379b980feadb2617b606ef694fbd4cf68142d5638
JWT_SECRET_VENDOR=62bf8ef56b772a3c0b232f6721e5955bfa09dd28fda1b3491d9e32fa0c486f1d
JWT_SECRET_ADMIN=042eabf40459518a30259b89d2d6fdcf7338666494e1a1df2d1930183f52cfa7

# Signs cookies (cookie-parser).
COOKIE_SECRET=2648254d6da8bc56522bbfe66b452cd9a8aa2ccfca049a45cd282379b3b382ba

# The single admin login. There is no admin record in the database: the login
# route compares against these two values directly, so an empty username locks
# the admin panel for everyone.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=5CvTFObDfLLMPQJJT7wUkVGK


# -----------------------------------------------------------------------------
# Google Sign-In  (optional — the button hides itself when unset)
# -----------------------------------------------------------------------------
# OAuth 2.0 **client ID** from Google Cloud Console (APIs & Services →
# Credentials → OAuth client ID → Web application). There is no client secret:
# the browser gets an ID token from Google Identity Services and the backend
# verifies its signature against Google's public keys.
# "Authorized JavaScript origins" must list every origin the site is served
# from — http://localhost:3041 for this setup, plus the live domain.
# A client ID is public by design (it ships inside the JS bundle).
GOOGLE_CLIENT_ID=
# Same value again, this one exposed to the browser so it can render the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# -----------------------------------------------------------------------------
# Email — Resend  (optional)
# -----------------------------------------------------------------------------
# Without a token the backend logs the email instead of sending it, which is
# usually what you want locally: verification links show up in
# `docker compose logs -f backend`.
RESEND_TOKEN=
# Must be an address on a domain verified in Resend, otherwise every send is
# rejected. Resend's own sandbox sender is the default when this is unset.
RESEND_FROM=ReadyMarine <onboarding@resend.dev>
# (optional) EMAIL_FROM is the older name, used only when RESEND_FROM is unset.
# EMAIL_FROM=


# -----------------------------------------------------------------------------
# WhatsApp — EverySecond  (optional)
# -----------------------------------------------------------------------------
# Carries the OTP codes, the invitations and the review requests. With no API
# key the service no-ops and logs, so phone-OTP signup cannot be completed
# locally unless you read the code out of the backend logs.
WHATSAPP_API_KEY=
WHATSAPP_BASE_URL=https://everysecond.ai
# Prefixed to the campaign name of every send, so the provider's dashboard
# shows where a message came from.
WHATSAPP_SENDER_NAME=ReadyCar
# Numeric template ids from the EverySecond dashboard. The defaults are the ids
# of the live ReadyCar templates — override them only if your account has its
# own. A wrong id sends the wrong text, it does not error.
# 19 = generic / notifications, 1 = otp_code (AUTHENTICATION).
WHATSAPP_TEMPLATE_ID=19
WHATSAPP_OTP_TEMPLATE_ID=1
WHATSAPP_VENDOR_REMINDER_TEMPLATE_ID=41
WHATSAPP_REVIEW_TEMPLATE_ID=42
WHATSAPP_INVITE_TEMPLATE_ID=47
# Prepended to local numbers before sending (Egypt = 20).
WHATSAPP_DEFAULT_COUNTRY_CODE=20
# (optional) Only needed on a multi-account EverySecond login.
# WHATSAPP_ACCOUNT_ID=


# -----------------------------------------------------------------------------
# AI chat commerce — EverySecond  (optional)
# -----------------------------------------------------------------------------
# The AI agent sells in chat (WhatsApp, Messenger, Instagram and the website
# chat window): the catalogue is synced to its menu, and the orders it takes
# are placed here as cash-on-delivery orders. See
# Backend/docs/EVERYSECOND_CHAT_COMMERCE.md. Blank key = the whole feature off.
#
# The key of the agent that sells (Dashboard → Integrations → the agent).
# Separate from WHATSAPP_API_KEY on purpose. NEVER the live agent's key on a
# development machine: the first sync reconciles, and a local database would
# replace the live menu with its own products. Use a test agent locally.
EVERYSECOND_API_KEY=
# Check the whole setup any time (read-only, never prints a key):
#   cd Backend && npm run everysecond:check
# The backend refuses to run the feature when this key equals WHATSAPP_API_KEY
# while MONGO_URI is a local database. Deliberate override (rarely right):
# EVERYSECOND_ALLOW_LIVE_AGENT_ON_LOCAL_DB=true
# Printed by `npm run everysecond:register-webhook -- https://<domain>/api/webhooks/everysecond`.
# EverySecond only delivers to a public https host.
EVERYSECOND_WEBHOOK_SECRET=
# How often the catalogue is compared with the agent's menu. 0 turns it off.
EVERYSECOND_SYNC_MINUTES=10
# Language of the product links on the menu (ar | en).
EVERYSECOND_PRODUCT_LOCALE=ar
# (optional, development only) Public https site the menu's product links point at
# when FRONTEND_URL is http://localhost. Production leaves it unset.
# EVERYSECOND_SITE_URL=https://readycar.store
# (optional) Per-order quantity cap for every item sold in chat.
# EVERYSECOND_MAX_QTY_PER_ORDER=
# Website chat spends the same monthly message quota as WhatsApp. 0 = no cap.
EVERYSECOND_WEB_CHAT_DAILY_LIMIT=1000
# false keeps the website cart out of the chat basket (chat → website still works).
EVERYSECOND_CART_TWO_WAY=true


# -----------------------------------------------------------------------------
# Payments — which gateway takes the money
# -----------------------------------------------------------------------------
# Not an env var: it is an admin setting (Admin → Wallets → Payment gateway).
# The switch refuses to move to a provider whose keys are blank, so fill the
# block below first. With both blank, cash on delivery still works — which is
# enough for a local run end to end.


# -----------------------------------------------------------------------------
# Payments — Fawaterak  (optional)
# -----------------------------------------------------------------------------
# `sandbox` (the default) talks to staging.fawaterk.com; anything other than
# the exact string `live` is treated as sandbox.
FAWATERAK_MODE=sandbox
FAWATERAK_SANDBOX_BASE_URL=https://staging.fawaterk.com
FAWATERAK_LIVE_BASE_URL=https://app.fawaterk.com
# (optional) Used only when the base URL for the active mode is unset.
# FAWATERAK_BASE_URL=
FAWATERAK_CURRENCY=EGP
# The two credentials from the Fawaterak dashboard. Note the keys differ
# between sandbox and live, and the API key is the bearer token.
FAWATERAK_API_KEY=
FAWATERAK_VENDOR_KEY=
# (optional) FAWATERAK_API_LINK and FAWATERAK_PROVIDED_APIKEY are the original
# names of those same two, still read as fallbacks. Prefer the pair above.
# FAWATERAK_API_LINK=
# FAWATERAK_PROVIDED_APIKEY=


# -----------------------------------------------------------------------------
# Payments — Paymob  (optional)
# -----------------------------------------------------------------------------
# These belong in Backend/.env. Do NOT list them in docker-compose.yml's
# `environment:` block — a name written there with no value overrides the
# env_file with an empty string whenever the shell does not export it, which
# silently disables the gateway.
#
# Everything below comes from the Accept Dashboard. Mind the test/live toggle
# in the top right: the secret and public keys are DIFFERENT per mode, while
# the API key is the same for both.
#
#   Settings → Developers → API Keys
PAYMOB_MODE=test
PAYMOB_SECRET_KEY_TEST=
PAYMOB_SECRET_KEY_LIVE=
PAYMOB_PUBLIC_KEY_TEST=
PAYMOB_PUBLIC_KEY_LIVE=
PAYMOB_API_KEY=
# Signs every callback. Found on the account/profile page, not with the keys
# above. Without it every Paymob webhook is rejected — deliberately: an
# unsigned callback is just a stranger's JSON.
PAYMOB_HMAC_SECRET=
#
#   Settings → Payment Integrations — one id per payment method PER MODE.
# An id from the wrong mode is rejected with a 404 that names neither. Leave a
# method blank and it is simply not offered; only the card id is required.
# On EVERY id, set both callback URLs (the admin screen shows them to copy):
#   Webhook URL  → https://your-domain.com/api/payments/paymob/webhook
#   Redirect URL → https://your-domain.com/api/payments/paymob/return
# Both are needed because only CARD integrations honour the URL sent with each
# individual payment; wallet, kiosk and BNPL use whatever is saved on the id.
PAYMOB_INTEGRATION_CARD_TEST=
PAYMOB_INTEGRATION_CARD_LIVE=
PAYMOB_INTEGRATION_WALLET_TEST=
PAYMOB_INTEGRATION_WALLET_LIVE=
# Kiosk is offered on wallet top-ups only — never on an order. See
# Backend/docs/PAYMOB_INTEGRATION.md for why.
PAYMOB_INTEGRATION_KIOSK_TEST=
PAYMOB_INTEGRATION_KIOSK_LIVE=
PAYMOB_INTEGRATION_BNPL_TEST=
PAYMOB_INTEGRATION_BNPL_LIVE=
# (optional) Endpoints, only worth setting if Paymob moves them.
# PAYMOB_BASE_URL=https://accept.paymob.com
# PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com
# PAYMOB_CURRENCY=EGP


# -----------------------------------------------------------------------------
# Shipping — Bosta  (optional)
# -----------------------------------------------------------------------------
# API base + key, from your Bosta business dashboard.
BOSTA_BASE_URL=https://app.bosta.co
BOSTA_API_KEY=
# Public HTTPS URL where Bosta posts delivery status updates. Must be a real
# domain with a TLD (no IP, no localhost) or Bosta rejects it outright, so this
# one cannot be exercised from a laptop without a tunnel. The secret goes in
# the path:  https://your-domain.com/api/webhooks/bosta/<BOSTA_WEBHOOK_SECRET>
BOSTA_WEBHOOK_URL=
# Shared secret verified on every incoming webhook (in the path, or ?secret=).
# When unset, verification is skipped — dev only.
BOSTA_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Shipping — Arrive  (optional)
# -----------------------------------------------------------------------------
# The second courier. Its webhook is
#   https://your-domain.com/api/webhooks/arrive/<ARRIVE_WEBHOOK_SECRET>
# and, same as Bosta, an unset secret means incoming calls are not verified.
ARRIVE_BASE_URL=https://arrive-shipping.com
# (optional) The API base the admin screen prints next to the webhook URL for
# copying into Arrive's dashboard. Defaults to FRONTEND_URL + /api.
# PUBLIC_API_URL=
ARRIVE_API_USER=
ARRIVE_API_PASSWORD=
ARRIVE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Behaviour knobs — all optional, all shown with their built-in default
# -----------------------------------------------------------------------------
# Phone OTP.
OTP_TTL_MINUTES=10
# Deliberately longer than the provider's delivery latency: two codes sent less
# than a minute apart to the same number are silently dropped upstream.
OTP_RESEND_COOLDOWN_SECONDS=120
OTP_MAX_RESENDS=5
OTP_MAX_ATTEMPTS=5
# (optional) Extra salt hashed into stored OTPs. Falls back to JWT_SECRET_USER,
# then COOKIE_SECRET; the backend warns at boot in production if all three are
# empty.
# OTP_PEPPER=

# Email links.
# 1440 minutes = 24 hours.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# How long a family member's order request waits for approval.
FAMILY_REQUEST_EXPIRY_HOURS=48

# Review requests. The sweep runs hourly, asks about a parcel a day after it
# arrived, and keeps retrying for a week if a send fails. Sending hours are on
# the store's clock, so nobody is woken at 4 AM.
REVIEW_INVITE_DELAY_HOURS=24
REVIEW_INVITE_TTL_DAYS=30
REVIEW_INVITE_RETRY_DAYS=7
REVIEW_INVITE_FROM_HOUR=10
REVIEW_INVITE_UNTIL_HOUR=21
STORE_TIMEZONE=Africa/Cairo

# Homepage service/ad banner rotation. When more than 25 banners are active,
# each balanced group owns one shift before the schedule repeats.
BANNER_SHIFT_MINUTES=60


# -----------------------------------------------------------------------------
# Seeding and local scripts  (optional)
# -----------------------------------------------------------------------------
# Where the category seeder looks for the scraped catalogue. Inside docker the
# ./readycar_scrapping folder is mounted here, and compose sets this already.
# READYCAR_SCRAPING_DIR=/app/readycar_scrapping

# `npm run seed` only fills empty collections. Set this to wipe and re-seed:
#   docker exec readymarine_backend npm run seed:reset
# RESET_SEED_DATA=true

# Target of `npm run reset:local-db`, kept separate from MONGO_URI on purpose:
# that script drops a database, and it should not be able to reach the server's.
# LOCAL_MONGO_URI=mongodb://localhost:27018/readymarine
