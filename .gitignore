# catalogue scraping
# Cached source HTML: ~8 GB of Liferay boilerplate, only ~1.5% of each page is
# the product blob we parse. Kept outside the repo as a local backup.
catalouge_scraping/*/data/raw/
catalouge_scraping/data/raw/
# Compiled Vision OCR helper (platform-specific build artifact)
catalouge_scraping/ocr/ocr

# Scraping data (kept locally, not in the repo)
catalouge_scraping/
bosta-scrapping/
products-scrape/
readycar_scrapping/
